# Copy to .env.local (git-ignored) and fill in. Optional: the key can also be pasted in
# Settings → Brain, which stores it in the phone's secure storage instead.
#
# Get a key at https://aistudio.google.com/apikey
# EXPO_PUBLIC_ variables are compiled into the app bundle — don't ship a public build with one.
EXPO_PUBLIC_GEMINI_API_KEY=
